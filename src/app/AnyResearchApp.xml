<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<MATLABApp schemaVersion='1.0.0' release='R2026b.0' minRelease='R2026b'>
    <UIFigure name='UIFigure'>
        <CloseRequestFcn>CloseRequestFcn</CloseRequestFcn>
        <Name>'AnyResearch'</Name>
        <Position>[100 100 1000 720]</Position>
        <Children>
            <GridLayout name='RootGrid'>
                <ColumnWidth>{'1x', 'fit'}</ColumnWidth>
                <RowHeight>{'fit', '1x', 'fit'}</RowHeight>
                <Padding>[12 12 12 12]</Padding>
                <RowSpacing>8</RowSpacing>
                <Children>
                    <Label name='AppTitleLabel'>
                        <Text>'AnyResearch'</Text>
                        <FontSize>18</FontSize>
                        <FontWeight>'bold'</FontWeight>
                        <Layout><Column>1</Column><Row>1</Row></Layout>
                    </Label>
                    <TabGroup name='MainTabGroup'>
                        <Layout><Column>[1 2]</Column><Row>2</Row></Layout>
                        <Children>
                            <Tab name='SearchTab'>
                                <Title>'Search'</Title>
                                <Children>
                                    <GridLayout name='SearchGrid'>
                                        <ColumnWidth>{'1x', 'fit'}</ColumnWidth>
                                        <RowHeight>{'1x', 'fit'}</RowHeight>
                                        <Padding>[12 12 12 12]</Padding>
                                        <RowSpacing>10</RowSpacing>
                                        <ColumnSpacing>10</ColumnSpacing>
                                        <Children>
                                            <Panel name='SearchParametersPanel'>
                                                <Title>'Layer 0 search parameters'</Title>
                                                <Layout><Column>[1 2]</Column><Row>1</Row></Layout>
                                                <Children>
                                                    <GridLayout name='SearchParametersGrid'>
                                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                                        <RowHeight>{'fit', 'fit', 'fit'}</RowHeight>
                                                        <Padding>[12 12 12 12]</Padding>
                                                        <RowSpacing>6</RowSpacing>
                                                        <Scrollable>'on'</Scrollable>
                                                        <Children>
                                                            <Panel name='BasicPanel'>
                                                                <Title>'Basic'</Title>
                                                                <Layout><Column>1</Column><Row>1</Row></Layout>
                                                                <Children>
                                                                    <GridLayout name='BasicGrid'>
                                                                        <ColumnWidth>{170, 170, '1x'}</ColumnWidth>
                                                                        <RowHeight>{'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit'}</RowHeight>
                                                                        <Padding>[12 12 12 12]</Padding>
                                                                        <RowSpacing>5</RowSpacing>
                                                                        <Children>
                                                                            <Label name='QueryLabel'><Text>'Query'</Text><Layout><Column>[1 3]</Column><Row>1</Row></Layout></Label>
                                                                            <EditField name='QueryEditField'><Placeholder>'e.g. machine learning AND (radar | lidar)'</Placeholder><Tooltip>'Space = AND, | = OR, "..." = exact phrase, ( ) = grouping. Example: "Simulink model" | Stateflow. To mix AND and OR, use parentheses: a (b | c).'</Tooltip><Layout><Column>[1 3]</Column><Row>2</Row></Layout></EditField>
                                                                            <Label name='FromDateLabel'><Text>'From date'</Text><Layout><Column>1</Column><Row>3</Row></Layout></Label>
                                                                            <Label name='ToDateLabel'><Text>'To date'</Text><Layout><Column>2</Column><Row>3</Row></Layout></Label>
                                                                            <DatePicker name='FromDatePicker'><DisplayFormat>'yyyy-MM-dd'</DisplayFormat><Layout><Column>1</Column><Row>4</Row></Layout></DatePicker>
                                                                            <DatePicker name='ToDatePicker'><DisplayFormat>'yyyy-MM-dd'</DisplayFormat><Layout><Column>2</Column><Row>4</Row></Layout></DatePicker>
                                                                            <Label name='SortByLabel'><Text>'Sort order'</Text><Layout><Column>[1 2]</Column><Row>5</Row></Layout></Label>
                                                                            <DropDown name='SortByDropDown'><Items>{'cited_by_count:desc', 'publication_date:desc', 'relevance_score'}</Items><Value>'cited_by_count:desc'</Value><Tooltip>'cited_by_count:desc = most cited first; publication_date:desc = newest first; relevance_score = best match to the query first.'</Tooltip><Layout><Column>[1 2]</Column><Row>6</Row></Layout></DropDown>
                                                                            <Label name='SearchFieldLabel'><Text>'Search in'</Text><Layout><Column>[1 2]</Column><Row>7</Row></Layout></Label>
                                                                            <DropDown name='SearchFieldDropDown'><Items>{'all', 'title_and_abstract'}</Items><Value>'all'</Value><Tooltip>'all = searches title, abstract and full text (broader, default); title_and_abstract = only the title and abstract, which is what the results table shows.'</Tooltip><Layout><Column>[1 2]</Column><Row>8</Row></Layout></DropDown>
                                                                        </Children>
                                                                    </GridLayout>
                                                                </Children>
                                                            </Panel>
                                                            <Panel name='FiltersPanel'>
                                                                <Title>'Filters'</Title>
                                                                <Layout><Column>1</Column><Row>2</Row></Layout>
                                                                <Children>
                                                                    <GridLayout name='FiltersGrid'>
                                                                        <ColumnWidth>{170, 170, '1x'}</ColumnWidth>
                                                                        <RowHeight>{'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit'}</RowHeight>
                                                                        <Padding>[12 12 12 12]</Padding>
                                                                        <RowSpacing>5</RowSpacing>
                                                                        <Children>
                                                                            <Label name='FilterTypeLabel'><Text>'Document type filter'</Text><Layout><Column>[1 2]</Column><Row>1</Row></Layout></Label>
                                                                            <EditField name='FilterTypeEditField'><Placeholder>'article, review, or blank for all'</Placeholder><Tooltip>'Enter document types separated by commas, or leave blank to include all types.'</Tooltip><Layout><Column>[1 2]</Column><Row>2</Row></Layout></EditField>
                                                                            <Label name='CitedByMinLabel'><Text>'Minimum citations'</Text><Layout><Column>1</Column><Row>3</Row></Layout></Label>
                                                                            <Label name='CitedByMaxLabel'><Text>'Maximum citations (0 = off)'</Text><Layout><Column>2</Column><Row>3</Row></Layout></Label>
                                                                            <NumericEditField name='CitedByMinField'><Limits>[0 Inf]</Limits><Value>0</Value><Tooltip>'Works with at least this many citations (the value itself is included).'</Tooltip><HorizontalAlignment>'left'</HorizontalAlignment><Layout><Column>1</Column><Row>4</Row></Layout></NumericEditField>
                                                                            <NumericEditField name='CitedByMaxField'><Limits>[0 Inf]</Limits><Value>0</Value><Tooltip>'Set to 0 for no maximum citation limit.'</Tooltip><HorizontalAlignment>'left'</HorizontalAlignment><Layout><Column>2</Column><Row>4</Row></Layout></NumericEditField>
                                                                            <Label name='LanguageLabel'><Text>'Language'</Text><Layout><Column>1</Column><Row>5</Row></Layout></Label>
                                                                            <Label name='CountryCodeLabel'><Text>'Country code'</Text><Layout><Column>2</Column><Row>5</Row></Layout></Label>
                                                                            <EditField name='LanguageEditField'><Value>'en'</Value><Tooltip>'Language code of the works, e.g. en or ja. Leave blank for all languages.'</Tooltip><Layout><Column>1</Column><Row>6</Row></Layout></EditField>
                                                                            <EditField name='CountryCodeEditField'><Value>'JP'</Value><Tooltip>'2-letter country codes of any author''s institution (not only the first author). | = OR (JP|US); + = AND, works with authors from every listed country (JP+US). Leave blank for all countries.'</Tooltip><Layout><Column>2</Column><Row>6</Row></Layout></EditField>
                                                                            <CheckBox name='RequireOpenAccessCheckBox'><Text>'Require Open Access'</Text><Value>true</Value><Layout><Column>[1 3]</Column><Row>7</Row></Layout></CheckBox>
                                                                            <CheckBox name='RequireAbstractCheckBox'><Text>'Require abstract'</Text><Value>true</Value><Layout><Column>[1 3]</Column><Row>8</Row></Layout></CheckBox>
                                                                        </Children>
                                                                    </GridLayout>
                                                                </Children>
                                                            </Panel>
                                                            <Panel name='AdvancedPanel'>
                                                                <Title>'Advanced'</Title>
                                                                <Layout><Column>1</Column><Row>3</Row></Layout>
                                                                <Children>
                                                                    <GridLayout name='AdvancedGrid'>
                                                                        <ColumnWidth>{170, 170, '1x'}</ColumnWidth>
                                                                        <RowHeight>{'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit'}</RowHeight>
                                                                        <Padding>[12 12 12 12]</Padding>
                                                                        <RowSpacing>5</RowSpacing>
                                                                        <Children>
                                                                            <Label name='SeedIdLabel'><Text>'Seed DOI or OpenAlex work ID'</Text><Layout><Column>[1 3]</Column><Row>1</Row></Layout></Label>
                                                                            <EditField name='SeedIdEditField'><Placeholder>'10.1234/example or W2741809807'</Placeholder><Tooltip>'Enter a DOI or OpenAlex work ID to use as the starting point for snowball retrieval.'</Tooltip><Layout><Column>[1 3]</Column><Row>2</Row></Layout></EditField>
                                                                            <Label name='SnowballModeLabel'><Text>'Snowball mode'</Text><Layout><Column>1</Column><Row>3</Row></Layout></Label>
                                                                            <DropDown name='SnowballModeDropDown'><Items>{'citing', 'referenced'}</Items><Value>'citing'</Value><Tooltip>'citing finds works that cite this work. referenced finds works cited by this work.'</Tooltip><Layout><Column>1</Column><Row>4</Row></Layout></DropDown>
                                                                            <Label name='TopNLabel'><Text>'Top N in Summary'</Text><Layout><Column>2</Column><Row>3</Row></Layout></Label>
                                                                            <NumericEditField name='TopNField'><Limits>[1 Inf]</Limits><RoundFractionalValues>'on'</RoundFractionalValues><Value>10</Value><Tooltip>'Number of top entries listed in the Summary sheet.'</Tooltip><HorizontalAlignment>'left'</HorizontalAlignment><Layout><Column>2</Column><Row>4</Row></Layout></NumericEditField>
                                                                            <Label name='MaxRecordsLabel'><Text>'Max records'</Text><Layout><Column>3</Column><Row>3</Row></Layout></Label>
                                                                            <NumericEditField name='MaxRecordsField'><Limits>[1 Inf]</Limits><RoundFractionalValues>'on'</RoundFractionalValues><Value>1000</Value><Tooltip>'Maximum number of works to fetch. Default 1000. If more works match, you are asked whether to fetch only this many or all of them.'</Tooltip><HorizontalAlignment>'left'</HorizontalAlignment><Layout><Column>3</Column><Row>4</Row></Layout></NumericEditField>
                                                                            <Label name='InstitutionLabel'><Text>'First-author institution'</Text><Layout><Column>[1 3]</Column><Row>5</Row></Layout></Label>
                                                                            <EditField name='InstitutionEditField'><Placeholder>'e.g. Nagoya University'</Placeholder><Tooltip>'Institution name of the first author. The name is expanded to related institution IDs (for example a university hospital).'</Tooltip><Layout><Column>[1 3]</Column><Row>6</Row></Layout></EditField>
                                                                            <Label name='InstitutionIdLabel'><Text>'Institution ID'</Text><Layout><Column>[1 3]</Column><Row>7</Row></Layout></Label>
                                                                            <EditField name='InstitutionIdEditField'><Placeholder>'I26973366'</Placeholder><Tooltip>'One or more OpenAlex institution IDs separated by | (OR). If First-author institution is also filled, both are used.'</Tooltip><Layout><Column>[1 3]</Column><Row>8</Row></Layout></EditField>
                                                                        </Children>
                                                                    </GridLayout>
                                                                </Children>
                                                            </Panel>
                                                        </Children>
                                                    </GridLayout>
                                                </Children>
                                            </Panel>
                                            <Button name='SearchRunButton'>
                                                <Text>'Run Search'</Text>
                                                <ButtonPushedFcn>SearchRunButtonPushed</ButtonPushedFcn>
                                                <Layout><Column>2</Column><Row>2</Row></Layout>
                                            </Button>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='BatchTab'>
                                <Title>'Batch'</Title>
                                <Children>
                                    <GridLayout name='BatchGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <RowHeight>{'fit', '1x', 'fit'}</RowHeight>
                                        <Padding>[12 12 12 12]</Padding>
                                        <RowSpacing>8</RowSpacing>
                                        <Children>
                                            <Label name='BatchStepLabel'><Text>'1. Generate candidates  →  2. Review  →  3. Promote  →  4. Run batch'</Text><FontWeight>'bold'</FontWeight><Layout><Column>1</Column><Row>1</Row></Layout></Label>
                                            <GridLayout name='BatchContentGrid'>
                                                <ColumnWidth>{'1x'}</ColumnWidth>
                                                <RowHeight>{'1x', 0, 0, 0}</RowHeight>
                                                <Layout><Column>1</Column><Row>2</Row></Layout>
                                                <Children>
                                                    <Panel name='BatchGeneratePanel'><Title>'Step 1 — Generate institution candidates'</Title><Layout><Column>1</Column><Row>1</Row></Layout><Children><GridLayout name='BatchGenerateGrid'><ColumnWidth>{170, '1x', 'fit'}</ColumnWidth><RowHeight>{'fit', '1x', 'fit', 'fit', 'fit'}</RowHeight><Padding>[12 12 12 12]</Padding><Children><Label name='TargetNamesLabel'><Text>'Target institution names'</Text><Layout><Column>[1 3]</Column><Row>1</Row></Layout></Label><TextArea name='TargetNamesTextArea'><Placeholder>'One institution name per line, e.g. Nagoya University'</Placeholder><Tooltip>'Enter one institution name per line.'</Tooltip><Layout><Column>[1 3]</Column><Row>2</Row></Layout></TextArea><Label name='PrepareCountryLabel'><Text>'Country filter'</Text><Layout><Column>1</Column><Row>3</Row></Layout></Label><EditField name='PrepareCountryEditField'><Value>'JP'</Value><Tooltip>'Filter candidate institution matches by country code. Leave blank to include all countries.'</Tooltip><Layout><Column>1</Column><Row>4</Row></Layout></EditField><Button name='GenerateCandidatesButton'><Text>'Generate candidates'</Text><ButtonPushedFcn>GenerateCandidatesButtonPushed</ButtonPushedFcn><Layout><Column>1</Column><Row>5</Row></Layout></Button></Children></GridLayout></Children></Panel>
                                                    <Panel name='BatchReviewPanel'><Title>'Step 2 — Review candidates'</Title><Visible>false</Visible><Layout><Column>1</Column><Row>2</Row></Layout><Children><GridLayout name='BatchReviewGrid'><ColumnWidth>{'fit', 'fit', '1x'}</ColumnWidth><RowHeight>{'1x', 'fit'}</RowHeight><Padding>[12 12 12 12]</Padding><Children><Table name='CandidateTable'><ColumnName>{'account', 'status', 'openalex_institution_id', 'display_name', 'include', 'role', 'note', 'country_code'}</ColumnName><ColumnWidth>{120, 110, 150, 220, 70, 100, 200, 90}</ColumnWidth><Tooltip>'Grey rows were carried over from the current institutions list; the latest search did not return them.'</Tooltip><Layout><Column>[1 3]</Column><Row>1</Row></Layout></Table><Button name='IncludeAllButton'><Text>'Include all'</Text><Tooltip>'Include every row with an OpenAlex institution ID.'</Tooltip><Layout><Column>1</Column><Row>2</Row></Layout></Button><Button name='IncludeNoneButton'><Text>'Include none'</Text><Tooltip>'Exclude every row from the batch.'</Tooltip><Layout><Column>2</Column><Row>2</Row></Layout></Button><Button name='ReviewCandidatesButton'><Text>'Save review and continue'</Text><ButtonPushedFcn>ReviewCandidatesButtonPushed</ButtonPushedFcn><Layout><Column>3</Column><Row>2</Row></Layout></Button></Children></GridLayout></Children></Panel>
                                                    <Panel name='BatchPromotePanel'><Title>'Step 3 — Promote reviewed candidates'</Title><Visible>false</Visible><Layout><Column>1</Column><Row>3</Row></Layout><Children><GridLayout name='BatchPromoteGrid'><ColumnWidth>{'1x'}</ColumnWidth><RowHeight>{'1x', 'fit'}</RowHeight><Padding>[12 12 12 12]</Padding><Children><Label name='PromoteHelpLabel'><Text>'Save the reviewed candidates as the institutions list used by batch runs. Only rows with include = 1 are searched. If a list already exists you will be asked to confirm, and the old file is kept as a backup.'</Text><WordWrap>'on'</WordWrap><Layout><Column>1</Column><Row>1</Row></Layout></Label><Button name='PromoteCandidatesButton'><Text>'Promote reviewed candidates'</Text><ButtonPushedFcn>PromoteCandidatesButtonPushed</ButtonPushedFcn><Layout><Column>1</Column><Row>2</Row></Layout></Button></Children></GridLayout></Children></Panel>
                                                    <Panel name='BatchRunPanel'><Title>'Step 4 — Run batch'</Title><Visible>false</Visible><Layout><Column>1</Column><Row>4</Row></Layout><Children><GridLayout name='BatchRunGrid'><ColumnWidth>{170, 170, '1x'}</ColumnWidth><RowHeight>{'fit', 'fit', 'fit', 'fit', 'fit', 'fit'}</RowHeight><Padding>[12 12 12 12]</Padding><Children><Label name='BatchQueryLabel'><Text>'Query'</Text><Layout><Column>[1 3]</Column><Row>1</Row></Layout></Label><EditField name='BatchQueryEditField'><Placeholder>'e.g. machine learning AND (radar | lidar)'</Placeholder><Layout><Column>[1 3]</Column><Row>2</Row></Layout></EditField><Label name='BatchFromDateLabel'><Text>'From date'</Text><Layout><Column>1</Column><Row>3</Row></Layout></Label><Label name='BatchToDateLabel'><Text>'To date'</Text><Layout><Column>2</Column><Row>3</Row></Layout></Label><DatePicker name='BatchFromDatePicker'><DisplayFormat>'yyyy-MM-dd'</DisplayFormat><Layout><Column>1</Column><Row>4</Row></Layout></DatePicker><DatePicker name='BatchToDatePicker'><DisplayFormat>'yyyy-MM-dd'</DisplayFormat><Layout><Column>2</Column><Row>4</Row></Layout></DatePicker><CheckBox name='BatchDryRunCheckBox'><Text>'Dry run (preview filters and counts only)'</Text><Tooltip>'Queries OpenAlex for each institution filter and result count, then writes the batch summary. It does not fetch works or create per-institution or merged result exports.'</Tooltip><Layout><Column>[1 3]</Column><Row>5</Row></Layout></CheckBox><Button name='RunBatchButton'><Text>'Run batch'</Text><ButtonPushedFcn>RunBatchButtonPushed</ButtonPushedFcn><Layout><Column>1</Column><Row>6</Row></Layout></Button></Children></GridLayout></Children></Panel>
                                                </Children>
                                            </GridLayout>
                                            <Button name='BatchBackButton'><Text>'Back'</Text><Enable>'off'</Enable><ButtonPushedFcn>BatchBackButtonPushed</ButtonPushedFcn><Layout><Column>1</Column><Row>3</Row></Layout></Button>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='AnalyticsPdfTab'>
                                <Title>'Analytics &amp; PDF'</Title>
                                <Children>
                                    <GridLayout name='AnalyticsPdfGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <RowHeight>{72, 'fit', '1x'}</RowHeight>
                                        <Padding>[12 12 12 12]</Padding>
                                        <RowSpacing>10</RowSpacing>
                                        <Children>
                                            <Panel name='AnalyticsPanel'><Title>'Layer 2 — Analytics'</Title><Layout><Column>1</Column><Row>1</Row></Layout><Children><Label name='AnalyticsStatusLabel'><Text>'Analytics are automatically computed and included in Layer 0 and Layer 1 results.'</Text><WordWrap>'on'</WordWrap><Position>[12 12 800 28]</Position></Label></Children></Panel>
                                            <Panel name='PdfPanel'><Title>'Layer 3 — PDF options'</Title><Layout><Column>1</Column><Row>2</Row></Layout><Children><GridLayout name='PdfOptionsGrid'><ColumnWidth>{170, '1x'}</ColumnWidth><RowHeight>{'fit', 'fit', 'fit', 'fit', 'fit'}</RowHeight><Padding>[12 12 12 12]</Padding><Children><CheckBox name='EnablePdfDownloadCheckBox'><Text>'Download Open Access PDFs'</Text><Tooltip>'Checks up to the specified number of OpenAlex result rows for an Open Access PDF and downloads it when available. This option is off by default.'</Tooltip><Layout><Column>[1 2]</Column><Row>1</Row></Layout></CheckBox><Label name='PdfMaxRowsLabel'><Text>'PDF check limit (first N results)'</Text><Layout><Column>1</Column><Row>2</Row></Layout></Label><NumericEditField name='PdfMaxRowsField'><Limits>[1 Inf]</Limits><RoundFractionalValues>'on'</RoundFractionalValues><Value>20</Value><Tooltip>'Limits PDF download processing to the first N rows of the OpenAlex results.'</Tooltip><HorizontalAlignment>'left'</HorizontalAlignment><Layout><Column>1</Column><Row>3</Row></Layout></NumericEditField><CheckBox name='EnablePdfTextCheckBox'><Text>'Extract PDF text'</Text><Value>true</Value><Tooltip>'Extracts text from downloaded PDFs. It does not run when PDF download is off.'</Tooltip><Layout><Column>[1 2]</Column><Row>4</Row></Layout></CheckBox><CheckBox name='EnableKeywordEvidenceCheckBox'><Text>'Extract keyword evidence'</Text><Value>true</Value><Tooltip>'Extracts keyword evidence from downloaded PDF text. It does not run when PDF download is off.'</Tooltip><Layout><Column>[1 2]</Column><Row>5</Row></Layout></CheckBox></Children></GridLayout></Children></Panel>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='SettingsTab'>
                                <Title>'Settings'</Title>
                                <Children>
                                    <GridLayout name='SettingsGrid'>
                                        <ColumnWidth>{'1x', 'fit'}</ColumnWidth>
                                        <RowHeight>{'fit', 'fit', 'fit', 'fit', '1x'}</RowHeight>
                                        <Padding>[12 12 12 12]</Padding>
                                        <RowSpacing>10</RowSpacing>
                                        <Children>
                                            <Label name='ApiKeyLabel'><Text>'OpenAlex API key'</Text><Layout><Column>[1 2]</Column><Row>1</Row></Layout></Label>
                                            <EditField name='ApiKeyEditField'><Placeholder>'Enter a new key to save it in config/settings.json'</Placeholder><Tooltip>'Saves the entered key to config/settings.json. The field is cleared after saving.'</Tooltip><Layout><Column>1</Column><Row>2</Row></Layout></EditField>
                                            <Button name='SaveApiKeyButton'><Text>'Save API key'</Text><ButtonPushedFcn>SaveApiKeyButtonPushed</ButtonPushedFcn><Tooltip>'Saves the entered API key. If ANYRESEARCH_OPENALEX_API_KEY is set, that environment variable continues to take precedence.'</Tooltip><Layout><Column>2</Column><Row>2</Row></Layout></Button>
                                            <Label name='SettingsHelpLabel'><Text>'Environment variable ANYRESEARCH_OPENALEX_API_KEY takes precedence over config/settings.json. The existing configuration mechanism is otherwise unchanged.'</Text><WordWrap>'on'</WordWrap><Layout><Column>[1 2]</Column><Row>3</Row></Layout></Label>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                        </Children>
                    </TabGroup>
                    <Label name='StatusLabel'>
                        <Text>'Ready.'</Text>
                        <Layout><Column>1</Column><Row>3</Row></Layout>
                    </Label>
                    <Button name='OpenOutputButton'>
                        <Text>'Open output folder'</Text>
                        <Tooltip>'Open the most recent output folder after a successful search or batch run.'</Tooltip>
                        <Enable>'off'</Enable>
                        <Layout><Column>2</Column><Row>3</Row></Layout>
                    </Button>
                </Children>
            </GridLayout>
        </Children>
    </UIFigure>
    <AppDetails>
        <Name>AnyResearchApp</Name>
        <Version>1.0</Version>
    </AppDetails>
    <InternalData>
        <AppId>de2ea148-ff2f-f7c2-6ecf-a0deacb6a2b0</AppId>
    </InternalData>
    <RunConfiguration>
        <StartupFcn>startupFcn</StartupFcn>
    </RunConfiguration>
    <Thumbnail autoCapture='true'></Thumbnail>
</MATLABApp>
